---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const crew = [
  { name: 'T’zel', role: 'ECHANI MONK', initials: 'T', tagline: 'Quiet hands. Quieter judgement.', bio: 'Echani monk. Notices who reaches for a weapon first.', portrait: 'media/crew/t-zel.png' },
  { name: 'Dax Thorne', role: 'HUMAN SCOUT / SMUGGLER', initials: 'DX', tagline: 'Honey in the voice. Static in the wake.', bio: 'Honey-tongued raconteur, scout, smuggler, and pilot of suspicious confidence. Has the hots for Sirona O’Keefe.', portrait: 'media/crew/dax.jpg' },
  { name: 'Deech Zhetriss', role: 'RODIAN JEDI SENTINEL', initials: 'DZ', tagline: 'Meditation is not an excuse to miss a briefing.', bio: 'Rodian Jedi sentinel. Keeps the archive, the ship, and his opinions in order.', portrait: 'media/crew/deech.png' },
  { name: 'Morkk the Guiltless Predator', role: 'TOGORIAN FIGHTER', initials: 'MK', tagline: 'Likes the Cloakshape when things get spicy.', bio: 'Togorian fighter. The title is self-appointed. No one has successfully challenged it.', portrait: 'media/crew/morkk.jpg' },
  { name: 'DV-8', role: 'HUMANOID DROID ENGINEER', initials: 'DV', tagline: 'The only one who reads the service manuals.', bio: 'Humanoid droid engineer. Keeps the fleet running and the organics within acceptable tolerances.', portrait: 'media/crew/dv-8.jpg' },
  { name: 'DV-U5', role: 'SMALL WHEELED DROID / DECEASED', initials: 'D-', tagline: 'Gone but still listed in the maintenance queue.', bio: 'Companion unit to DV-8. Deceased in the line of duty. The memorial request remains under review.', portrait: 'media/crew/dv-u5.jpg' },
  { name: 'DV-Rangoon', role: 'LARGE CLAW-LIKE DROID', initials: 'DR', tagline: 'Current sidekick. Unclear supervision model.', bio: 'Large claw-like droid and current sidekick to DV-8. Strong grip. Questionable initiative.', portrait: 'media/crew/dv-rangoon.jpg' },
  { name: 'Maurice', role: 'GUNGAN ENGINEER / ARMORTECH', initials: 'MO', tagline: 'Makes the hull tougher. Makes the room louder.', bio: 'Gungan engineer armortech. The hull is tougher. The arguments are louder.', portrait: 'media/crew/maurice.png' },
  { name: 'Borís', role: 'GUNGAN SNIPER OPERATIVE', initials: 'BO', tagline: 'Already has the angle.', bio: 'Gungan sniper operative. Quiet until the shot is taken, then quieter still.', portrait: 'media/crew/boris.png' },
  { name: 'Stalker', role: 'CATHAR OPERATIVE / PAST COMPATRIOT', initials: 'ST', tagline: 'No longer aboard. Still counted.', bio: 'Cathar operative and past compatriot. The file remains open, though the bunk does not.', portrait: null },
];
const carouselCrew = crew;
---
<Layout title="Crew Roster" active="Crew Roster">
  <section class="detail-hero"><div class="page-wrap"><p class="kicker">Personnel manifest // click a record to unseal</p><h1>Crew roster</h1><p class="lede" style="margin-top:24px">A volatile roster entrusted with three ships, a resistance cell, and one another.</p></div></section>
  <section class="section"><div class="page-wrap"><div class="carousel-shell"><button class="carousel-control prev" data-carousel="crew-track" aria-label="Previous crew member">←</button><div id="crew-track" class="carousel-track">
    {carouselCrew.map(({ name, role, initials, tagline, bio, portrait }, index) => <article class:list={['plate', 'crew-card', index === 0 ? 'is-active' : '']}><div class:list={['crew-portrait', portrait ? 'has-image' : '']} >{portrait ? <img src={`${base}${portrait}`} alt={`${name} portrait`} /> : <span class="crew-initials">{initials}</span>}</div><div class="crew-info"><span class="rank">{role}</span><h3>{name}</h3><p class="species">{tagline}</p><p class="bio-copy">{portrait ? 'Portrait supplied by the crew.' : 'Portrait withheld. The file still checks out.'}</p><button class="bio-toggle" type="button">UNSEAL BIO +</button><div class="bio">{bio}</div></div></article>)}
  </div><button class="carousel-control next" data-carousel="crew-track" aria-label="Next crew member">→</button></div></div></section>
  <section class="section"><div class="page-wrap"><div class="quote-panel"><div><p class="kicker">Roster note</p><p class="mono text-muted">STATUS: STILL BREATHING</p></div><div><blockquote>“If everyone is still breathing, it counts as a successful shift.”</blockquote><cite>— DV-8, refusing to define “everyone”</cite></div></div></div></section>
  <script>
    const updateActive = (track) => {
      const centre = track.scrollLeft + (track.clientWidth / 2);
      let closest = null;
      let distance = Infinity;
      track.querySelectorAll('.crew-card, .ship-card').forEach((card) => {
        const cardCentre = card.offsetLeft + (card.offsetWidth / 2);
        const delta = Math.abs(cardCentre - centre);
        if (delta < distance) { distance = delta; closest = card; }
        card.classList.remove('is-active');
      });
      closest?.classList.add('is-active');
    };
    document.querySelectorAll('.carousel-track').forEach((track) => {
      const centreInitial = () => {
        const target = track.querySelector('.crew-card, .ship-card');
        if (target) track.scrollLeft = target.offsetLeft - ((track.clientWidth - target.offsetWidth) / 2);
        updateActive(track);
      };
      track.addEventListener('scroll', () => window.requestAnimationFrame(() => updateActive(track)), { passive: true });
      window.addEventListener('load', centreInitial, { once: true });
      window.requestAnimationFrame(() => window.requestAnimationFrame(centreInitial));
    });
    const centreCard = (track, card) => {
      track.scrollTo({ left: card.offsetLeft - ((track.clientWidth - card.offsetWidth) / 2), behavior: 'smooth' });
    };
    const navigate = (track, direction) => {
      const cards = [...track.querySelectorAll('.crew-card')];
      const activeIndex = cards.indexOf(track.querySelector('.is-active'));
      if (activeIndex < 0) return;
      const nextIndex = (activeIndex + direction + cards.length) % cards.length;
      centreCard(track, cards[nextIndex]);
    };
    document.addEventListener('click', (event) => {
      const control = event.target.closest('[data-carousel]');
      const card = event.target.closest('.carousel-track .crew-card');
      if (control) {
        const track = document.getElementById(control.dataset.carousel);
        if (!track) return;
        navigate(track, control.classList.contains('next') ? 1 : -1);
      } else if (card && !card.classList.contains('is-active') && !event.target.closest('button, a')) {
        centreCard(card.closest('.carousel-track'), card);
      }
    });
    document.querySelectorAll('.bio-toggle').forEach((button) => button.addEventListener('click', () => {
      const card = button.closest('.crew-card');
      const revealed = card.classList.toggle('revealed');
      button.textContent = revealed ? 'SEAL BIO −' : 'UNSEAL BIO +';
    }));
  </script>
</Layout>
