---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const crew = [
  ['T’zel', 'ECHANI MONK', 'T', 'Quiet hands. Quieter judgement.', 'Echani monk. Notices who reaches for a weapon first.'],
  ['Dax Throne', 'HUMAN SCOUT / SMUGGLER', 'DX', 'Honey in the voice. Static in the wake.', 'Honey-tongued raconteur, scout, smuggler, and pilot of suspicious confidence. Has the hots for Sirona O’Keefe.'],
  ['Deech Zhetriss', 'RODIAN JEDI SENTINEL', 'DZ', 'Meditation is not an excuse to miss a briefing.', 'Rodian Jedi sentinel. Keeps the archive, the ship, and his opinions in order.'],
  ['Morkk the Guiltless Predator', 'TOGORIAN FIGHTER', 'MK', 'Likes the Cloakshape when things get spicy.', 'Togorian fighter. The title is self-appointed. No one has successfully challenged it.'],
  ['DV-8', 'HUMANOID DROID ENGINEER', 'DV', 'The only one who reads the service manuals.', 'Humanoid droid engineer. Keeps the fleet running and the organics within acceptable tolerances.'],
  ['DV-US', 'SMALL WHEELED DROID / DECEASED', 'D-', 'Gone but still listed in the maintenance queue.', 'Companion unit to DV-8. Deceased in the line of duty. The memorial request remains under review.'],
  ['DV-Rangoon', 'LARGE CLAW-LIKE DROID', 'DR', 'Current sidekick. Unclear supervision model.', 'Large claw-like droid and current sidekick to DV-8. Strong grip. Questionable initiative.'],
  ['Maurice', 'GUNGAN ENGINEER / ARMORTECH', 'MO', 'Makes the hull tougher. Makes the room louder.', 'Gungan engineer armortech. The hull is tougher. The arguments are louder.'],
  ['Borís', 'GUNGAN SNIPER OPERATIVE', 'BO', 'Already has the angle.', 'Gungan sniper operative. Quiet until the shot is taken, then quieter still.'],
  ['Stalker', 'CATHAR OPERATIVE / PAST COMPATRIOT', 'ST', 'No longer aboard. Still counted.', 'Cathar operative and past compatriot. The file remains open, though the bunk does not.'],
];
const carouselCrew = [crew[crew.length - 1], ...crew, crew[0]];
---
<Layout title="Crew Roster" active="Crew Roster">
  <section class="detail-hero"><div class="page-wrap"><p class="kicker">Personnel manifest // click a record to unseal</p><h1>Crew roster</h1><p class="lede" style="margin-top:24px">A volatile roster entrusted with three ships, a resistance cell, and one another.</p></div></section>
  <section class="section"><div class="page-wrap"><div class="carousel-shell"><button class="carousel-control prev" data-carousel="crew-track" aria-label="Previous crew member">←</button><div id="crew-track" class="carousel-track">
    {carouselCrew.map(([name, role, initials, tagline, bio], index) => <article class:list={['plate', 'crew-card', index === 1 ? 'is-active' : '']}><div class="crew-portrait"><span class="crew-initials">{initials}</span></div><div class="crew-info"><span class="rank">{role}</span><h3>{name}</h3><p class="species">{tagline}</p><p class="bio-copy">Placeholder portrait pending a cooperative photographer.</p><button class="bio-toggle" type="button">UNSEAL BIO +</button><div class="bio">{bio}</div></div></article>)}
  </div><button class="carousel-control next" data-carousel="crew-track" aria-label="Next crew member">→</button></div></div></section>
  <section class="section"><div class="page-wrap"><div class="quote-panel"><div><p class="kicker">Roster note</p><p class="mono text-muted">STATUS: STILL BREATHING</p></div><div><blockquote>“If everyone is still breathing, it counts as a successful shift.”</blockquote><cite>— DV-8, refusing to define “everyone”</cite></div></div></div></section>
  <script>
    const updateActive = (track) => {
      const centre = track.scrollLeft + (track.clientWidth / 2);
      let closest = null;
      let distance = Infinity;
      track.querySelectorAll('.crew-card, .ship-card').forEach((card) => {
        const cardCentre = card.offsetLeft + (card.offsetWidth / 2);
        const delta = Math.abs(cardCentre - centre);
        if (delta < distance) { distance = delta; closest = card; }
        card.classList.remove('is-active');
      });
      closest?.classList.add('is-active');
    };
    document.querySelectorAll('.carousel-track').forEach((track) => {
      const centreInitial = () => {
        const target = track.querySelectorAll('.crew-card, .ship-card')[1] || track.querySelector('.crew-card, .ship-card');
        if (target) track.scrollLeft = target.offsetLeft - ((track.clientWidth - target.offsetWidth) / 2);
        updateActive(track);
      };
      track.addEventListener('scroll', () => window.requestAnimationFrame(() => updateActive(track)), { passive: true });
      window.addEventListener('load', centreInitial, { once: true });
      window.requestAnimationFrame(() => window.requestAnimationFrame(centreInitial));
    });
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-carousel]');
      if (!button) return;
      const track = document.getElementById(button.dataset.carousel);
      if (!track) return;
      track.scrollBy({ left: button.classList.contains('next') ? track.clientWidth * .72 : -track.clientWidth * .72, behavior: 'auto' });
    });
    document.querySelectorAll('.bio-toggle').forEach((button) => button.addEventListener('click', () => {
      const card = button.closest('.crew-card');
      const revealed = card.classList.toggle('revealed');
      button.textContent = revealed ? 'SEAL BIO −' : 'UNSEAL BIO +';
    }));
  </script>
</Layout>
