---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="The Blacksite Archive" active="Home">
  <section class="hero">
    <img class="hero-image" src={`${base}images/glorious-chariot.png`} alt="The Glorious Chariot on its reinforced landing deck" />
    <div class="hero-content">
      <p class="kicker">Field archive // DoD 01—06 // transmission unsecured</p>
      <h1>We came for the <span>cause.</span><br />We stayed for the ships.</h1>
      <p class="lede">Dispatches from a small resistance crew with a stolen yacht, several questionable alliances, and a habit of surviving places that were meant to kill them.</p>
      <div class="hero-meta">
        <span>Current berth <strong>Coruscant / classified</strong></span>
        <span>Operational status <strong>holding together</strong></span>
        <span>Primary vessel <strong>Glorious Chariot</strong></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-wrap">
      <div class="section-head">
        <div><p class="kicker">Start here</p><h2>Pick a trail.</h2></div>
        <p>Filed by the people who were there, the people who cleaned up afterwards, and one droid who has retained the incident reports.</p>
      </div>
      <div class="signal-grid">
        <article class="plate plate-top signal-card"><span class="code">LOG / 001</span><h3>Travelogue</h3><p>Short dispatches from the road, usually written before the next alarm.</p><a href={`${base}travelogue/`}>Read the field notes →</a></article>
        <article class="plate plate-top signal-card"><span class="code">MANIFEST / 002</span><h3>Crew roster</h3><p>Ten names, a few aliases, and more technical opinions than the ship requires.</p><a href={`${base}crew/`}>Inspect the personnel →</a></article>
        <article class="plate plate-top signal-card"><span class="code">HANGAR / 003</span><h3>Our whips</h3><p>The vessels that got us here. Their ownership histories are best read with the doors locked.</p><a href={`${base}hangar/`}>Enter the hangar →</a></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-wrap">
      <div class="stats">
        <div class="stat"><strong>06</strong><span>Adventures completed</span></div>
        <div class="stat"><strong>10</strong><span>Passenger capacity</span></div>
        <div class="stat"><strong>03</strong><span>Ships in the hangar</span></div>
        <div class="stat"><strong>01</strong><span>Storyteller concealed</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-wrap">
      <div class="quote-panel">
        <div><p class="kicker">Intercepted from the bridge</p><p class="mono text-muted">NO FURTHER COMMENT</p></div>
        <div><blockquote>“The Empire has a lot of rules about ownership. Fortunately, none of them survived the explosion.”</blockquote><cite>— attributed to Dax Throne, after the acquisition of the Glorious Chariot</cite></div>
      </div>
    </div>
  </section>
</Layout>
